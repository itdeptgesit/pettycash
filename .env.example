# Environment Variables untuk Petty Cash Direksi (Vercel & Lokal)
# Salin file ini menjadi .env atau pasang di Project Settings -> Environment Variables pada Vercel.

# 1. Kata sandi login aplikasi (Wajib diisi di Vercel agar aplikasi aman)
APP_PASSWORD=rahasia123

# 2. Kunci Google Service Account (Wajib untuk mode integrasi Google Sheets & Drive)
# Masukkan seluruh isi JSON service account dalam format 1 baris string terkompresi.
# Contoh: {"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com"}
GOOGLE_SERVICE_ACCOUNT_KEY=

# 3. ID Spreadsheet & Google Drive Folder (Opsional, sudah ada nilai bawaan di kode)
GOOGLE_SPREADSHEET_ID=1hR86L_IvJwemOlbf4QIsHtwc-d5jnm8cTMwSHvRJqLU
GOOGLE_DRIVE_FOLDER_ID=1mpWB3Uz1nyQyMIAooSF_cZfCU24t-Pbm
